# This repository intentionally tracks the application, its tests,
# root project documents, and design specifications.
/*
!/.gitignore
!/LICENSE
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/todo.md
!/Package.swift
!/app/
!/app.Tests/
!/Sources/
!/Sources/**
!/Tests/
!/Tests/**
!/docs/
!/docs/**
!/public/
!/public/docs/
!/public/docs/**
!/scripts/
!/scripts/**
!/script/
!/script/**
!/.codex/
!/.codex/environments/
!/.codex/environments/environment.toml

# Build and IDE output
**/bin/
**/obj/
**/.artifacts/
.build/
.vs/
*.user
*.suo

# Local configuration and diagnostics
.local-signing/
*.log
.env
.env.*
appsettings.local.json

# Editor / operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
